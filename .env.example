# Copy to .env (never commit .env) and export before running, e.g.:
#   set -a; source .env; set +a; ./mvnw spring-boot:run
# Spring Boot reads these as ordinary OS environment variables.

# --- Database (required: DB_PASSWORD) ---
DB_URL=jdbc:postgresql://localhost:1574/job_tracker
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# --- JWT (required, at least 32 bytes). Generate with:  openssl rand -base64 48 ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MS=86400000

# --- CORS: exact origin(s) of the React app, comma separated, no wildcard ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- OpenAI (optional: without a key the app boots and AI endpoints answer 503) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG / pgvector ---
RAG_ENABLED=true
RAG_INITIALIZE_SCHEMA=true

# --- Misc ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SPRINGDOC_ENABLED=true

